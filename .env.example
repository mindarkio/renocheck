# Copy to .env.local — never commit real values

# Public site URL (metadata, sitemap, robots). Production: https://renocheck.homes
NEXT_PUBLIC_SITE_URL=

# Supabase — https://supabase.com/dashboard/project/lvrasvtilgzwtfsfjbzd/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://lvrasvtilgzwtfsfjbzd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# D2 golden parity is opt-in (`pnpm test:d2` sets RUN_D2_GOLDEN=1).
# Prod anon cannot read mwc_contractors. Point test:d2 at local Supabase or a dev project.
# A production project ref is refused. Do not read .env.local from the D2 scripts.
# SUPABASE_PROD_PROJECT_REFS 預設已包括 lvrasvtilgzwtfsfjbzd；可以加多個，用逗號分隔。
# SUPABASE_PROD_PROJECT_REFS=

# Track 1 court judgments (DEC-0012); requires official_legal_events + import
# Dev: on by default. Production: set LEGAL_EVENTS_ENABLED=1 (or 0 to force off locally)
# LEGAL_EVENTS_ENABLED=1

# Search — Serper preferred (DEC-0008); SerpAPI fallback if Serper unset
SERPER_API_KEY=
# SERPAPI_KEY=
# SERP_PROVIDER=serper
# SERP_GL=hk
# SERP_HL=zh-HK
# Optional: Serp pages to fetch (1–3, default 2 → up to 20 organic hits per query)
# SERP_PAGE_COUNT=2
# SerpAPI-only: SERP_GOOGLE_DOMAIN=google.com.hk
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# Admin search analytics dashboard (server-only; set in Vercel only)
ADMIN_DASHBOARD_PIN=
# 32+ random chars, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Emergency cap on user-facing risk band (server-only). Unset = no cap.
# RISK_BAND_MAX=風險中等
# RISK_BAND_MAX=中性

# AI — pick one path:
# Local dev: Google AI Studio → https://aistudio.google.com/apikey
# Official name for @ai-sdk/google (alias GOOGLE_GENERATIVE_AI_KEY also works)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override (default gemini-3.5-flash; do not use retired gemini-2.0-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Optional display-only counters copied from AI Studio. Unset shows 未設定. Not secrets.
# GEMINI_RPD_LIMIT=
# GEMINI_RPM_LIMIT=
# Manual pause: 1 shows the landing banner and makes POST /api/search return 503 service_paused.
# SERVICE_PAUSED=
# Vercel deploy: AI Gateway (gpt-4o-mini). Company reports only. Quote analysis never uses this.
AI_GATEWAY_API_KEY=

# Quote analysis Q1 (DEC-0013). Default OFF. Set to 1 only after Aaron applies the
# quote_analysis migration and the Azure + Supabase SMTP setup in the PR.
# QUOTE_ANALYSIS_ENABLED=1
# Server-only HMAC key for the OTP / verify rate-limit buckets. 32+ random chars,
# e.g. openssl rand -hex 32. Set in Vercel before QUOTE_ANALYSIS_ENABLED=1:
# missing or shorter than 32 makes /api/auth/otp and /api/auth/verify return 503.
# AUTH_RATE_LIMIT_SECRET=
# Anonymous company-name extractions per IP per Hong Kong day. Default 2. Zero blocks.
# QUOTE_ANON_DAILY_LIMIT=2
# Japan East resource endpoint from the Azure portal, e.g. https://<resource>.openai.azure.com
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# Global Standard deployment name of gpt-6-luna on that resource.
# AZURE_OPENAI_DEPLOYMENT=
# App-side daily cap in US dollars (Azure has no hard cap). Default 1 (DEC-0013 D36).
# QUOTE_DAILY_BUDGET_USD=1
# Free analyses stop at this amount. All analyses are free for now, so this is
# the effective stop. Default 0.80 (D36b). The US$1 cap above still applies.
# QUOTE_FREE_DAILY_BUDGET_USD=0.8
# Hard cap on Azure calls per Hong Kong day, checked in the same locked row. Default 300.
# QUOTE_DAILY_CALL_CAP=300
# Optional checklist item 加總唔一致. Default off. Set to 1 to include it.
# QUOTE_ARITHMETIC_ENABLED=0
